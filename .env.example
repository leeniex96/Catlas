# Copy this file to .env.local and fill in your own project's values
# (Supabase dashboard -> Project Settings -> API Keys).
#
# The "publishable" key is designed to be public: it ships inside the website, and
# Row Level Security rules in the database decide what visitors can actually do.
# NEVER put a "secret" or "service_role" key in a VITE_ variable.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
